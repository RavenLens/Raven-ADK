OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY_RAVENADK=your_gemini_api_key_here
RUNPOD_API_KEY=your_runpod_api_key_here
RUNPOD_ENDPOINT_ID=your_runpod_endpoint_id_here
RUNPOD_MODEL=your_runpod_model_name_here
FAL_KEY=your_fal_api_key_here
FAL_PODCAST_TEXT_MODEL=fal-ai/bytedance/seed/v2/mini
# Used only when FAL_PODCAST_TEXT_MODEL is an openrouter/* endpoint.
FAL_PODCAST_LLM_MODEL=google/gemini-2.5-flash-lite
FAL_PODCAST_TTS_MODEL=fal-ai/inworld-tts
FAL_PODCAST_IMAGE_MODEL=fal-ai/flux/schnell
FAL_PODCAST_AVATAR_MODEL=fal-ai/sadtalker
FAL_PODCAST_HOST_VOICE=Sarah (en)
FAL_PODCAST_GUEST_VOICE=Ethan (en)
# Persistent output root for fal.ai live-test requests, responses, and media.
FAL_PODCAST_OUTPUT_DIR=./test/podcast/artifacts
# Optional overrides when ffmpeg/ffprobe are not on PATH.
FAL_PODCAST_FFMPEG_PATH=ffmpeg
FAL_PODCAST_FFPROBE_PATH=ffprobe
# General fal request timeout. Video jobs use the longer avatar-specific value.
FAL_PODCAST_REQUEST_TIMEOUT_MS=165000
# SadTalker queue/inference timeout and matching live-test timeout.
FAL_PODCAST_AVATAR_REQUEST_TIMEOUT_MS=300000
FAL_PODCAST_AVATAR_TEST_TIMEOUT_MS=315000
# Optional provider-specific two-stage adapters:
# FAL_PODCAST_LIPSYNC_MODEL=your_audio_to_motion_endpoint
# FAL_PODCAST_AVATAR_STAGE2_MODEL=your_motion_to_video_endpoint
# FAL_PODCAST_AUDIO_COMPOSER_MODEL=your_audio_composition_endpoint
FAI_API_KEY=your_fai_ai_api_key_here
